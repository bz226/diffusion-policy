+                inds_b, (self.n_steps * self.n_envs, self.model.ft_denoising_steps)
+            )
+            (
+                pg_loss, entropy_loss, _, clipfrac, approx_kl, ratio, bc_loss, eta
+            ) = self.model.loss(
+                {"state": obs_k["state"][batch_inds_b]},
+                chains_k[batch_inds_b, denoising_inds_b],
+                chains_k[batch_inds_b, denoising_inds_b + 1],
+                denoising_inds_b,
+                returns_k[batch_inds_b],
+                values_k[batch_inds_b],
+                advantages_k[batch_inds_b],
