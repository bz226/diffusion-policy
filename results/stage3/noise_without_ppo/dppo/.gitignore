# Ordinary source snapshot; original upstream rules are in ../provenance/.
# Keep source, measurements, result.pkl, and Hydra configurations versionable.
# Runtime logs and command/monitor transcripts stay local.
*.log
*.log.*
*.out
*.err
commands.jsonl
*_commands.jsonl
monitor_history.jsonl
*_monitor_history.jsonl
*_monitor.jsonl
events.jsonl
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
.env
.env.*
!.env.example
wandb/
build/
dist/
*.egg-info/
.tox/
.nox/
cache/
.cache/
checkpoint/
checkpoints/
data/
datasets/
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.h5
*.hdf5
*.zarr/
*.zarr.zip
