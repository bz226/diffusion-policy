+        return None
+    required = dict(schema_version=1, approved=True,
+                    gradient_mean_max_parallel=4, critic_max_parallel=3)
+    if not isinstance(item, dict) or any(type(item.get(key)) is not type(value) or
+                                        item.get(key) != value for key, value in required.items()):
+        raise ValueError('Invalid four-G/three-C scheduling approval')
+    return item
